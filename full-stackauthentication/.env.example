# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local development: mongodb://localhost:27017/task_scheduler
# For production: mongodb+srv://<user>:<password>@cluster.mongodb.net/task_scheduler
MONGODB_URI=mongodb://localhost:27017/task_scheduler

# JWT Configuration
# IMPORTANT: Use a strong random string (minimum 32 characters) in production
# Generate one at: https://generate-random.org/api-key-generator
JWT_SECRET=bunna_bank_super_secret_jwt_key_2026_change_this_in_production_32chars_minimum
JWT_EXPIRE=7d

# Email Configuration (Gmail)
# IMPORTANT: Use Google App Password, not your regular password
# How to generate App Password:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate a new app password
# 4. Use that password below
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Frontend Configuration
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000
