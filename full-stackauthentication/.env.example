# ============================================================
#  BUNNA BANK — BACKEND .env.example
#  Copy this file to .env and fill in your values
# ============================================================

PORT=5000
NODE_ENV=development

# JWT Secret (use a strong random string, min 32 chars)
JWT_SECRET=change_this_to_a_strong_random_secret_key_minimum_32_chars
JWT_EXPIRE=7d

# MongoDB Atlas URI
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@cluster0.xxxxx.mongodb.net/bunna_bank_db?retryWrites=true&w=majority

# Email (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Bunna Bank <noreply@bunnabank.com>

# Frontend URL (for CORS)
# LOCAL: http://localhost:3000
# RENDER: https://YOUR-FRONTEND-SERVICE-NAME.onrender.com
FRONTEND_URL=http://localhost:3000
